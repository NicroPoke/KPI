{
  "manifest_version": 3,
  "name": "DecisionDex",
  "description": "DecisionDex extension for Opera (Chromium).",
  "version": "0.1.0",
  "action": {
    "default_title": "DecisionDex",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
